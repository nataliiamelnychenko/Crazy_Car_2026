#pragma vector=PORT1_VECTOR
__interrupt void Port_1(void)
{
    // Überprüfen, ob das erwartete Flag gesetzt ist
    if (P1IFG & BIT3)
    {
        // → gewünschte Reaktion (z. B. Flag setzen, Aktion auslösen)

        // Interrupt-Flag löschen
        P1IFG &= ~BIT3;
    }
}
